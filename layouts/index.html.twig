{% extends 'base.html.twig' %}

{% block head %}
    {%- if page.faq.items is defined ~%}
    <script type="application/ld+json">
      {{ {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': page.faq.items|map(q => {
          '@type': 'Question',
          'name': q.question,
          'acceptedAnswer': {'@type': 'Answer', 'text': q.answer|striptags}
        })
      }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}
    </script>
    {%- endif ~%}
{% endblock %}

{% block content %}
    {{~ include('partials/sections/hero.html.twig') ~}}
    {{~ include('partials/sections/problems.html.twig') ~}}
    {{~ include('partials/sections/expertises.html.twig') ~}}
    {{~ include('partials/sections/audiences.html.twig') ~}}
    {{~ include('partials/sections/method.html.twig') ~}}
    {{~ include('partials/sections/references.html.twig') ~}}
    {{~ include('partials/sections/why.html.twig') ~}}
    {{~ include('partials/sections/team.html.twig') ~}}
    {{~ include('partials/sections/faq.html.twig') ~}}
    {{~ include('partials/sections/contact.html.twig') ~}}
{% endblock %}
{%- set s = page.contact -%}
<section class="alt contact" id="contact">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">{{ s.eyebrow }}</span>
      <h2>{{ s.title }}</h2>
      <p class="lead">{{ s.lead }}</p>
    </div>
    {#- Formulaire géré par Netlify Forms (détecté au déploiement), avec champ anti-spam #}
    <form name="contact" method="post" action="{{ url('success') }}" data-netlify="true" netlify-honeypot="bot-field" class="card reveal">
      <input type="hidden" name="form-name" value="contact">
      <p class="honeypot"><label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <div><label for="f-name">Nom</label><input id="f-name" type="text" name="name" autocomplete="name" required></div>
      <div><label for="f-company">Entreprise</label><input id="f-company" type="text" name="company" autocomplete="organization"></div>
      <div class="full"><label for="f-email">E-mail</label><input id="f-email" type="email" name="email" autocomplete="email" required></div>
      <div class="full">
        <label for="f-need">Type de besoin</label>
        <select id="f-need" name="need">
          {%- for need in s.needs %}
          <option>{{ need }}</option>
          {%- endfor %}
        </select>
      </div>
      <div class="full"><label for="f-msg">Message</label><textarea id="f-msg" name="message" required></textarea></div>
      <div class="full"><button class="btn btn-primary" type="submit">{{ s.submit }}</button></div>
    </form>
  </div>
</section>

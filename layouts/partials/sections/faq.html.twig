{%- set s = page.faq ~%}
      <section id="faq">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">{{ s.eyebrow }}</span>
            <h2>{{ s.title }}</h2>
          </div>
          <div class="faq">
            {%- for item in s.items ~%}
            <details name="faq"><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>
            {%- endfor ~%}
          </div>
        </div>
      </section>
{%- set s = page.problems ~%}
      <section class="alt" id="enjeux">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">{{ s.eyebrow }}</span>
            <h2>{{ s.title }}</h2>
          </div>
          <div class="grid grid-2">
            {%- for item in s.items ~%}
            <article class="card problem reveal">
              {{ include('partials/icon.html.twig', {name: item.icon}) }}
              <h3>{{ item.title }}</h3>
              <p>{{ item.text }}</p>
            </article>
            {%- endfor ~%}
          </div>
        </div>
      </section>